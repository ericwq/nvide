{
  "extends": "default",
  "meta": {
    "name": "pi-mono"
  },
  "groups": {
    "include": [
      "node_runtime"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "$HOME/.pi/agent/",
      "$HOME/develop/projects/",
      "/tmp/",
      "$HOME/develop/MDE/",
      "$HOME/.m2/",
      "$HOME/.m2_test/",
      "$HOME/.gradle/",
      "$HOME/.rustup/settings.toml"
    ],
    "read": [
      "/opt/pyvenv/",
      "$JAVA_HOME/conf/security/",
      "/etc/java-21-openjdk/",
      "/etc/java-17-openjdk/",
      "$HOME/.npm-global/",
      "/etc/maven/",
      "/opt/maven/",
      "/opt/gradle/",
      "$HOME/.rustup",
      "$HOME/.cargo/",
      "/usr/libexec/gcc/"
    ],
    "allow_file": [
      "/opt/pyvenv/pyvenv.cfg"
    ]
  }
}
